---
# This file is intentionally driven by front matter so Jekyll renders the Liquid below.
# It builds an RSS 2.0 feed from every page that has a `date` in its front matter
# (your article .md files). index.md has no date, so it is excluded automatically.
# Add a new article with title/date front matter and it shows up here on the next build.
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title | xml_escape }}</title>
    <description>{{ site.description | xml_escape }}</description>
    <link>{{ site.url }}{{ site.baseurl }}/</link>
    <atom:link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/rss+xml" />
    <language>en</language>
    {% assign articles = site.pages | where_exp: "p", "p.date" | sort: "date" | reverse %}
    {% if articles.first %}<lastBuildDate>{{ articles.first.date | date_to_rfc822 }}</lastBuildDate>{% endif %}
    {% for post in articles %}
    <item>
      <title>{{ post.title | xml_escape }}</title>
      <link>{{ post.url | absolute_url }}</link>
      <guid isPermaLink="true">{{ post.url | absolute_url }}</guid>
      <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
      {% for tag in post.tags %}<category>{{ tag | xml_escape }}</category>
      {% endfor %}<description>{{ post.content | strip_html | normalize_whitespace | truncate: 500 | xml_escape }}</description>
    </item>
    {% endfor %}
  </channel>
</rss>
